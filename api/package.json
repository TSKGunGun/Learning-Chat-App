{
  "name": "@learning-chat-app/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node ./scripts/fix-dist-imports.mjs",
    "tsc": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "cross-env TMPDIR=.tmp vitest run",
    "generate:openapi-types": "openapi-typescript ../docs/specs/api/openapi/openapi.yaml -o ./src/generated/openapi-types.ts",
    "db:generate": "cross-env TMPDIR=.tmp drizzle-kit generate --name=users_and_sessions",
    "db:migrate": "cross-env TMPDIR=.tmp node --import tsx ./src/db/migrate.ts",
    "db:seed": "cross-env TMPDIR=.tmp node --import tsx ./src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@langchain/openai": "^1.4.7",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.12.21",
    "langchain": "^1.4.2",
    "openai": "^6.39.1",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.15.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.7",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "pg-mem": "^3.0.5",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
